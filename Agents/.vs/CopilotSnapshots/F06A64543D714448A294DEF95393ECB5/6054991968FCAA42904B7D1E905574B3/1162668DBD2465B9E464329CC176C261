using System;
using System.IO;
using System.Linq;
using System.Threading.Tasks;
using Azure;
using Azure.AI.DocumentIntelligence;
using Microsoft.Agents.AI.Workflows;
using Microsoft.Extensions.AI;

public static class DocumentExtractionService
{
    public static async Task<string> ExtractJdJsonAsync(DocumentIntelligenceClient docClient, IChatClient chatClient, string filePath)
    {
        var bytes = await File.ReadAllBytesAsync(filePath);

        var op = await docClient.AnalyzeDocumentAsync(
            WaitUntil.Completed,
            "prebuilt-layout",
            BinaryData.FromBytes(bytes));

        var result = op.Value;
        var text = string.Join("\n", result.Paragraphs.Select(p => p.Content));

        var messages = new List<ChatMessage>
        {
            new(ChatRole.System,
                "Extract the following job description into JSON with keys: role_name, employment_type, experience, relevant_experience, primary_skills, secondary_skills. Rules: (1) If a 'Required Skills & Qualifications' section exists, take the skills from the first four bullet lines from that section as primary_skills; any remaining bullets from that section go to secondary_skills. (2) Otherwise, primary_skills must only contain the core technologies explicitly tied to the 'What are we looking for' statement (e.g., Web Application and Web API development using .NET Core) and the directly associated stack (.NET Core, C# 6 or above, .NET Core MVC, .NET Core Web API, Entity Framework Core). (3) Everything else goes into secondary_skills. (4) Return JSON only."),
            new(ChatRole.User, text)
        };

        var resp = await chatClient.GetResponseAsync(messages);
        var respMsg = resp.Messages?.LastOrDefault();
        var jdJson = respMsg?.GetType().GetProperty("Text")?.GetValue(respMsg) as string
            ?? respMsg?.ToString()
            ?? resp.ToString();

        return jdJson;
    }

    public static async Task<string> ExtractResumeJsonAsync(DocumentIntelligenceClient docClient, IChatClient chatClient, string filePath)
    {
        var bytes = await File.ReadAllBytesAsync(filePath);

        var op = await docClient.AnalyzeDocumentAsync(
            WaitUntil.Completed,
            "prebuilt-layout",
            BinaryData.FromBytes(bytes));

        var result = op.Value;
        var text = string.Join("\n", result.Paragraphs.Select(p => p.Content));

        var messages = new List<ChatMessage>
        {
            new(ChatRole.System,
                "Extract the following resume into JSON with keys: Name, Education, Technical Skills, Experience in years, Work Experience, Projects, Certifications, Languages. Return JSON only."),
            new(ChatRole.User, text)
        };

        var resp = await chatClient.GetResponseAsync(messages);
        var respMsg = resp.Messages?.LastOrDefault();
        var resumeJson = respMsg?.GetType().GetProperty("Text")?.GetValue(respMsg) as string
            ?? respMsg?.ToString()
            ?? resp.ToString();

        return resumeJson;
    }

    public static string DetectContentType(string path
)
    {
        var ext = Path.GetExtension(path).ToLowerInvariant();
        return ext switch
        {
            ".pdf" => "application/pdf",
            ".docx" => "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            ".doc" => "application/msword",
            _ => "application/octet-stream"
        };
    }
}
