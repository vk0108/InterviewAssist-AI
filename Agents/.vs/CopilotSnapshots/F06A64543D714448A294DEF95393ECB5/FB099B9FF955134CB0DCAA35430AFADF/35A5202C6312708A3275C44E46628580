using System;
using System.IO;
using System.Linq;
using System.Threading.Tasks;
using Azure;
using Azure.AI.DocumentIntelligence;
using Microsoft.Agents.AI.Workflows;
using Microsoft.Extensions.AI;

public static class DocumentExtractionService
{
    public static async Task<string> ExtractJdJsonAsync(DocumentIntelligenceClient docClient, IChatClient chatClient, string filePath)
    {
        var bytes = await File.ReadAllBytesAsync(filePath);

        var op = await docClient.AnalyzeDocumentAsync(
            WaitUntil.Completed,
            "prebuilt-layout",
            BinaryData.FromBytes(bytes));

        var result = op.Value;
        var text = string.Join("\n", result.Paragraphs.Select(p => p.Content));

        var messages = new List<ChatMessage>
        {
            new(ChatRole.System,
                "Extract the following job description into JSON with keys: role_name, employment_type, experience, relevant_experience, primary_skills, secondary_skills. Rules: (1) Ignore any bullets that contain experience/years wording (e.g., 'year', 'years', 'experience'); they must not appear in primary_skills or secondary_skills. (2) For the remaining requirement/skills bullets, primary_skills come ONLY from bold/emphasized text. From those bold segments, drop requirement phrasing (tokens containing 'must', 'should', 'able', 'relevant'); keep only the skill/tech nouns. Split into atomic phrases on commas, slashes, parentheses, hyphens, and conjunctions (and/&); trim; remove quotes/dots; deduplicate. (3) All non-bold content from those remaining bullets goes to secondary_skills; split similarly and exclude any token already in primary_skills. (4) If bold/emphasis cannot be detected, leave primary_skills empty and put all non-experience bullets into secondary_skills (split and dedupe as above). (5) If the section is absent, primary_skills must only contain the core technologies explicitly tied to the 'What are we looking for' statement (e.g., Web Application and Web API development using .NET Core) and the directly associated stack (.NET Core, C# 6 or above, .NET Core MVC, .NET Core Web API, Entity Framework Core); everything else goes into secondary_skills. (6) Return JSON only."),
            new(ChatRole.User, text)
        };

        var resp = await chatClient.GetResponseAsync(messages);
        var respMsg = resp.Messages?.LastOrDefault();
        var jdJson = respMsg?.GetType().GetProperty("Text")?.GetValue(respMsg) as string
            ?? respMsg?.ToString()
            ?? resp.ToString();

        return jdJson;
    }

    public static async Task<string> ExtractResumeJsonAsync(DocumentIntelligenceClient docClient, IChatClient chatClient, string filePath)
    {
        var bytes = await File.ReadAllBytesAsync(filePath);

        var op = await docClient.AnalyzeDocumentAsync(
            WaitUntil.Completed,
            "prebuilt-layout",
            BinaryData.FromBytes(bytes));

        var result = op.Value;
        var text = string.Join("\n", result.Paragraphs.Select(p => p.Content));
        var Currentyear = DateTime.Now.Year;
        var messages = new List<ChatMessage>
        {
            new(ChatRole.System,
                $"Extract the following resume into JSON with keys: Name, Education, Technical Skills, Experience in years (first capture any explicitly stated total experience such as '3+ years', '3 years', etc.; treat that as the minimum and do not return a lower number; if no explicit value, compute from Work Experience dates by clamping end_date to the current date and summing durations; never exceed what is explicitly stated), Work Experience (each with role, company, start_date, end_date or present, duration_years if dates provided, tech_stack listing explicit frameworks/tech used such as .NET Core, ASP.NET MVC/Web API, Blazor, C#, Entity Framework, plus responsibilities/achievements bullets summarizing what was done in that role), Projects, Certifications, Languages. Preserve framework and stack names verbatim where present (e.g., '.NET Core', 'C#', 'ASP.NET MVC', 'ASP.NET Web API', 'Blazor'). If dates are partial, estimate conservatively; do not project into the future beyond the current date. Return JSON only."),
            new(ChatRole.User, text)
        };

        var resp = await chatClient.GetResponseAsync(messages);
        var respMsg = resp.Messages?.LastOrDefault();
        var resumeJson = respMsg?.GetType().GetProperty("Text")?.GetValue(respMsg) as string
            ?? respMsg?.ToString()
            ?? resp.ToString();

        return resumeJson;
    }

    public static string DetectContentType(string path
)
    {
        var ext = Path.GetExtension(path).ToLowerInvariant();
        return ext switch
        {
            ".pdf" => "application/pdf",
            ".docx" => "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            ".doc" => "application/msword",
            _ => "application/octet-stream"
        };
    }
}
