using System;
using System.IO;
using System.Linq;
using System.Threading.Tasks;
using Azure;
using Azure.AI.DocumentIntelligence;
using Microsoft.Agents.AI.Workflows;
using Microsoft.Extensions.AI;

public static class DocumentExtractionService
{
    public static async Task<string> ExtractJdJsonAsync(DocumentIntelligenceClient docClient, IChatClient chatClient, string filePath)
    {
        var bytes = await File.ReadAllBytesAsync(filePath);

        var op = await docClient.AnalyzeDocumentAsync(
            WaitUntil.Completed,
            "prebuilt-layout",
            BinaryData.FromBytes(bytes));

        var result = op.Value;
        var text = string.Join("\n", result.Paragraphs.Select(p => p.Content));

        var messages = new List<ChatMessage>
        {
            new(ChatRole.System,
                "Extract the following job description into JSON with keys: role_name, employment_type, experience, relevant_experience, primary_skills, secondary_skills. Rules: (1) If a 'Required Skills & Qualifications' section exists, take only the first four bullet lines from that section. From those lines, split into atomic skill phrases (split on commas, slashes, parentheses; trim; remove quotes/dots; deduplicate) and place them in primary_skills. (2) Any remaining bullets from that section become secondary_skills; also split into atomic skill phrases similarly. (3) If that section is absent, primary_skills must only contain the core technologies explicitly tied to the 'What are we looking for' statement (e.g., Web Application and Web API development using .NET Core) and the directly associated stack (.NET Core, C# 6 or above, .NET Core MVC, .NET Core Web API, Entity Framework Core). (4) Everything else goes into secondary_skills. (5) Return JSON only."),
            new(ChatRole.User, text)
        };

        var resp = await chatClient.GetResponseAsync(messages);
        var respMsg = resp.Messages?.LastOrDefault();
        var jdJson = respMsg?.GetType().GetProperty("Text")?.GetValue(respMsg) as string
            ?? respMsg?.ToString()
            ?? resp.ToString();

        return jdJson;
    }

    public static async Task<string> ExtractResumeJsonAsync(DocumentIntelligenceClient docClient, IChatClient chatClient, string filePath)
    {
        var bytes = await File.ReadAllBytesAsync(filePath);

        var op = await docClient.AnalyzeDocumentAsync(
            WaitUntil.Completed,
            "prebuilt-layout",
            BinaryData.FromBytes(bytes));

        var result = op.Value;
        var text = string.Join("\n", result.Paragraphs.Select(p => p.Content));

        var today = DateTime.UtcNow.ToString("yyyy-MM-dd");
        var resumeSystemPrompt = "Extract the following resume into JSON with keys: Name, Education, Technical Skills, Experience in years (total_experience_years to 1 decimal), Work Experience (role, company, start_date, end_date or present if stated, duration_years to 1 decimal), Projects, Certifications, Languages. Do NOT invent start/end dates. If dates are not stated, leave them null/empty. Compute duration_years only when dates or an explicit duration are given; otherwise leave duration_years null/empty. Derive total_experience_years by summing available duration_years from Work Experience (avoid double-counting overlaps). If totals cannot be derived, leave total_experience_years null/empty. Return JSON only.";

        var messages = new List<ChatMessage>
        {
            new(ChatRole.System, resumeSystemPrompt),
            new(ChatRole.User, text)
        };

        var resp = await chatClient.GetResponseAsync(messages);
        var respMsg = resp.Messages?.LastOrDefault();
        var resumeJson = respMsg?.GetType().GetProperty("Text")?.GetValue(respMsg) as string
            ?? respMsg?.ToString()
            ?? resp.ToString();

        return resumeJson;
    }

    public static string DetectContentType(string path
)
    {
        var ext = Path.GetExtension(path).ToLowerInvariant();
        return ext switch
        {
            ".pdf" => "application/pdf",
            ".docx" => "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            ".doc" => "application/msword",
            _ => "application/octet-stream"
        };
    }
}
