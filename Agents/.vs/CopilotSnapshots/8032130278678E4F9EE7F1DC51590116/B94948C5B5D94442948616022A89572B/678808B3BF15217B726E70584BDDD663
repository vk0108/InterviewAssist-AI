using System;
using System.Collections.Generic;
using System.Linq;
using System.Text.Json;
using System.Threading.Tasks;
using Microsoft.Agents.AI;
using Microsoft.Agents.AI.Workflows;
using Microsoft.Extensions.AI;
using QuestPDF.Fluent;
using QuestPDF.Helpers;
using QuestPDF.Infrastructure;

QuestPDF.Settings.License = LicenseType.Community;

public sealed class ConvoSumm
{
    public static async Task GenerateAsync(
        EnvironmentConfig config,
        IEnumerable<string> exchangeHistory,
        IEnumerable<int> scores,
        string finalDecisionText,
        string candidateName,
        string outputPath)
    {
        var historyText = string.Join("\n---\n", exchangeHistory);
        var scoresText = string.Join(", ", scores);
        if (string.IsNullOrWhiteSpace(historyText))
        {
            Console.WriteLine("No interview history available; skipping report generation.");
            return;
        }

        var systemPrompt = """
You are a report writer generating a concise interview report as JSON.
Structure the JSON exactly as follows:
{
  "quickRecap": string,
  "technicalTraining": [ { "title": string, "summary": string, "rating": number } ],
  "softSkills": [ { "title": string, "summary": string, "rating": number } ],
  "discussionSummary": string,
  "discussionTopics": [ { "title": string, "summary": string } ],
  "interviewerComments": string
}
Guidelines:
- Base everything only on the provided interview conversation history and evaluator scores.
- Derive ratings from evaluator scores: when multiple questions touch the same topic, aggregate/average their scores (1-5). If only one question for a topic, use that score. Use the final score after follow-ups if present. Keep ratings in 1-5 range.
- technicalTraining: include 3-6 key skills/topics discussed, each with a short summary and the aggregated rating.
- softSkills: include items like communication, attitude, collaboration, with rating 1-5 inferred from dialogue tone/content.
- quickRecap: 3-4 sentences summarizing overall performance and decision readiness.
- discussionSummary: 2-3 sentences recapping the overall discussion.
- discussionTopics: 4-8 titled sections; each title is the topic name and the summary is 2-5 sentences detailing what was discussed, strengths, and gaps.
- interviewerComments: brief recommendation; if decision indicates not to proceed or concerns, state it clearly.
Keep language concise and professional.
""";
        var userPrompt = $"Interview conversation history with evaluator scores (look for 'Score: N'):\n{historyText}\n\nAll recorded scores: {scoresText}\nFinal manager decision text: {finalDecisionText}\nReturn only the JSON schema above.";

        var summarizerAgent = new ChatClientAgent(
            config.ChatClient,
            systemPrompt,
            "report_summarizer",
            "Generates structured interview report JSON");

        var messages = new List<ChatMessage>
        {
            new(ChatRole.User, userPrompt)
        };

        string json;
        try
        {
            var result = await summarizerAgent.RunAsync(messages, thread: null, options: null, cancellationToken: default);
            var last = result.Messages?.LastOrDefault();
            json = last?.GetType().GetProperty("Text")?.GetValue(last) as string
                ?? last?.ToString()
                ?? string.Empty;
            json = json.Trim();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LLM summarization failed: {ex.Message}");
            return;
        }

        ReportPayload payload;
        try
        {
            payload = JsonSerializer.Deserialize<ReportPayload>(json, new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            }) ?? new ReportPayload();
        }
        catch
        {
            payload = new ReportPayload();
        }

        payload.QuickRecap ??= string.Empty;
        payload.DiscussionSummary ??= string.Empty;
        payload.InterviewerComments ??= string.Empty;
        payload.TechnicalTraining ??= new List<SectionItem>();
        payload.SoftSkills ??= new List<SectionItem>();
        payload.DiscussionTopics ??= new List<DiscussionTopic>();

        if (payload.TechnicalTraining.Count == 0)
        {
            payload.TechnicalTraining.Add(new SectionItem { Title = "Overall Technical", Summary = payload.DiscussionSummary, Rating = scores.Any() ? scores.Average() : 0 });
        }

        if (payload.SoftSkills.Count == 0)
        {
            payload.SoftSkills.Add(new SectionItem { Title = "Communication", Summary = "Not provided", Rating = 0 });
        }

        if (payload.DiscussionTopics.Count == 0)
        {
            if (!string.IsNullOrWhiteSpace(payload.DiscussionSummary))
            {
                payload.DiscussionTopics.Add(new DiscussionTopic { Title = "Overall Discussion", Summary = payload.DiscussionSummary });
            }
            else
            {
                payload.DiscussionTopics.Add(new DiscussionTopic { Title = "Discussion", Summary = "Not provided" });
            }
        }

        // Print to console
        PrintReport(candidateName, payload);

        // Generate PDF
        try
        {
            GeneratePdfReport(candidateName, payload, scores, outputPath);
            Console.WriteLine($"\n✅ PDF Report generated successfully: {outputPath}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"\n❌ PDF generation failed: {ex.Message}");
        }
    }

    private static void PrintReport(string candidateName, ReportPayload payload)
    {
        Console.WriteLine($"\n===== Interview Report - {candidateName} =====");
        Console.WriteLine("\nQuick Recap:\n" + payload.QuickRecap);

        Console.WriteLine("\nTechnical Training:");
        foreach (var item in payload.TechnicalTraining)
        {
            Console.WriteLine($"- {item.Title} (Rating: {item.Rating:F1}/5): {item.Summary}");
        }

        Console.WriteLine("\nSoft Skills:");
        foreach (var item in payload.SoftSkills)
        {
            Console.WriteLine($"- {item.Title} (Rating: {item.Rating:F1}/5): {item.Summary}");
        }

        Console.WriteLine("\nSummary of Discussion:");
        foreach (var topic in payload.DiscussionTopics)
        {
            Console.WriteLine($"\n{topic.Title}:");
            Console.WriteLine(topic.Summary);
        }

        Console.WriteLine("\nInterviewer Comments:\n" + payload.InterviewerComments);
        Console.WriteLine("===== End of Report =====\n");
    }

    private static void GeneratePdfReport(string candidateName, ReportPayload payload, IEnumerable<int> scores, string outputPath)
    {
        var averageScore = scores.Any() ? scores.Average() : 0;

        Document.Create(container =>
        {
            container.Page(page =>
            {
                page.Size(PageSizes.A4);
                page.Margin(40);
                page.PageColor(Colors.White);
                page.DefaultTextStyle(x => x.FontSize(11).FontFamily("Calibri"));

                page.Header().Element(container => ComposeHeader(container, candidateName));
                page.Content().Element(container => ComposeContent(container, payload, averageScore, scores.Count()));
                page.Footer().Element(ComposeFooter);
            });
        })
        .GeneratePdf(outputPath);
    }

    private static void ComposeHeader(IContainer container, string candidateName)
    {
        container.Column(column =>
        {
            column.Item().BorderBottom(2).BorderColor(Colors.Blue.Darken2).PaddingBottom(10).Row(row =>
            {
                row.RelativeItem().Column(col =>
                {
                    col.Item().Text("Interview Report").FontSize(24).Bold().FontColor(Colors.Blue.Darken2);
                    col.Item().Text(candidateName).FontSize(18).SemiBold().FontColor(Colors.Grey.Darken2);
                });

                row.ConstantItem(120).AlignRight().Column(col =>
                {
                    col.Item().Text($"Date: {DateTime.Now:MMM dd, yyyy}").FontSize(10);
                    col.Item().Text($"Time: {DateTime.Now:HH:mm}").FontSize(10);
                });
            });

            column.Item().PaddingTop(5);
        });
    }

    private static void ComposeContent(IContainer container, ReportPayload payload, double averageScore, int totalQuestions)
    {
        container.Column(column =>
        {
            // Quick Recap Section
            column.Item().PaddingTop(15).Element(container => ComposeSectionTitle(container, "Quick Recap"));
            column.Item().PaddingTop(5).PaddingBottom(10).Text(payload.QuickRecap)
                .FontSize(11).LineHeight(1.5f);

            // Overall Performance Box
            column.Item().PaddingTop(10).PaddingBottom(15).Background(Colors.Grey.Lighten3)
                .Padding(15).Column(col =>
                {
                    col.Item().Row(row =>
                    {
                        row.RelativeItem().Text($"Average Score: {averageScore:F2} / 5.0").FontSize(14).Bold();
                        row.RelativeItem().AlignRight().Text($"Questions Asked: {totalQuestions}").FontSize(12).SemiBold();
                    });
                    col.Item().PaddingTop(5).Element(container => ComposeScoreBar(container, averageScore));
                });

            // Technical Training Section
            column.Item().PaddingTop(15).Element(container => ComposeSectionTitle(container, "Technical Training"));
            column.Item().PaddingTop(5).Table(table =>
            {
                table.ColumnsDefinition(columns =>
                {
                    columns.RelativeColumn(3);
                    columns.ConstantColumn(60);
                    columns.RelativeColumn(5);
                });

                foreach (var item in payload.TechnicalTraining)
                {
                    table.Cell().BorderBottom(1).BorderColor(Colors.Grey.Lighten2)
                        .PaddingVertical(8).Text(item.Title).FontSize(11).SemiBold();

                    table.Cell().BorderBottom(1).BorderColor(Colors.Grey.Lighten2)
                        .PaddingVertical(8).AlignCenter().Element(container => ComposeRatingBadge(container, item.Rating));

                    table.Cell().BorderBottom(1).BorderColor(Colors.Grey.Lighten2)
                        .PaddingVertical(8).PaddingLeft(10).Text(item.Summary).FontSize(10).LineHeight(1.4f);
                }
            });

            // Soft Skills Section
            column.Item().PaddingTop(15).Element(container => ComposeSectionTitle(container, "Soft Skills"));
            column.Item().PaddingTop(5).Table(table =>
            {
                table.ColumnsDefinition(columns =>
                {
                    columns.RelativeColumn(3);
                    columns.ConstantColumn(60);
                    columns.RelativeColumn(5);
                });

                foreach (var item in payload.SoftSkills)
                {
                    table.Cell().BorderBottom(1).BorderColor(Colors.Grey.Lighten2)
                        .PaddingVertical(8).Text(item.Title).FontSize(11).SemiBold();

                    table.Cell().BorderBottom(1).BorderColor(Colors.Grey.Lighten2)
                        .PaddingVertical(8).AlignCenter().Element(container => ComposeRatingBadge(container, item.Rating));

                    table.Cell().BorderBottom(1).BorderColor(Colors.Grey.Lighten2)
                        .PaddingVertical(8).PaddingLeft(10).Text(item.Summary).FontSize(10).LineHeight(1.4f);
                }
            });

            // Summary of Discussion Section
            column.Item().PaddingTop(15).Element(container => ComposeSectionTitle(container, "Summary of Discussion"));
            column.Item().PaddingTop(5).Column(col =>
            {
                foreach (var topic in payload.DiscussionTopics)
                {
                    col.Item().PaddingTop(10).Column(topicCol =>
                    {
                        topicCol.Item().Text(topic.Title).FontSize(12).SemiBold().FontColor(Colors.Blue.Darken1);
                        topicCol.Item().PaddingTop(3).PaddingLeft(10).Text(topic.Summary)
                            .FontSize(10).LineHeight(1.5f);
                    });
                }
            });

            // Interviewer Comments Section
            column.Item().PaddingTop(15).Element(container => ComposeSectionTitle(container, "Interviewer Comments"));
            column.Item().PaddingTop(5).Background(Colors.Blue.Lighten4).Padding(12)
                .Text(payload.InterviewerComments).FontSize(11).LineHeight(1.5f);
        });
    }

    private static void ComposeSectionTitle(IContainer container, string title)
    {
        container.BorderBottom(1).BorderColor(Colors.Blue.Darken1).PaddingBottom(5)
            .Text(title).FontSize(14).Bold().FontColor(Colors.Blue.Darken2);
    }

    private static void ComposeRatingBadge(IContainer container, double rating)
    {
        var color = rating switch
        {
            >= 4.5 => Colors.Green.Darken1,
            >= 3.5 => Colors.Green.Lighten1,
            >= 2.5 => Colors.Orange.Lighten1,
            >= 1.5 => Colors.Orange.Darken1,
            _ => Colors.Red.Darken1
        };

        container.Background(color).Padding(4).AlignCenter()
            .Text($"{rating:F1}/5").FontSize(10).Bold().FontColor(Colors.White);
    }

    private static void ComposeScoreBar(IContainer container, double score)
    {
        var percentage = (score / 5.0) * 100;
        var color = score switch
        {
            >= 4.0 => Colors.Green.Darken1,
            >= 3.0 => Colors.Green.Lighten1,
            >= 2.0 => Colors.Orange.Lighten1,
            _ => Colors.Red.Darken1
        };

        container.Row(row =>
        {
            row.RelativeItem().Height(20).Border(1).BorderColor(Colors.Grey.Darken1).Row(innerRow =>
            {
                innerRow.RelativeItem((float)percentage).Background(color);
                innerRow.RelativeItem((float)(100 - percentage)).Background(Colors.Grey.Lighten2);
            });
            row.ConstantItem(60).PaddingLeft(10).AlignMiddle()
                .Text($"{percentage:F1}%").FontSize(12).Bold();
        });
    }

    private static void ComposeFooter(IContainer container)
    {
        container.AlignCenter().Text(text =>
        {
            text.Span("Generated by ").FontSize(9).FontColor(Colors.Grey.Darken1);
            text.Span("AI Interview Assistant").FontSize(9).SemiBold().FontColor(Colors.Blue.Darken2);
            text.Span(" | www.interviewassist.com").FontSize(9).FontColor(Colors.Grey.Darken1);
        });
    }

    private sealed class ReportPayload
    {
        public string? QuickRecap { get; set; }
        public List<SectionItem>? TechnicalTraining { get; set; }
        public List<SectionItem>? SoftSkills { get; set; }
        public string? DiscussionSummary { get; set; }
        public List<DiscussionTopic>? DiscussionTopics { get; set; }
        public string? InterviewerComments { get; set; }
    }

    private sealed class SectionItem
    {
        public string? Title { get; set; }
        public string? Summary { get; set; }
        public double Rating { get; set; }
    }

    private sealed class DiscussionTopic
    {
        public string? Title { get; set; }
        public string? Summary { get; set; }
    }
}