using System.Threading.Tasks;

public class Program
{
    public static async Task Main()
    {
        var config = EnvironmentConfig.Build();

        if (System.Environment.GetEnvironmentVariable("LANG_CHECK") == "1")
        {
            var lang = new AzureLanguageService(config);
            await lang.CheckConnectionAsync();
            return;
        }

        var agents = AgentFactory.Create(config.ChatClient);
        var workflow = new InterviewWorkflow(config, agents);
        await workflow.RunAsync();
    }
}