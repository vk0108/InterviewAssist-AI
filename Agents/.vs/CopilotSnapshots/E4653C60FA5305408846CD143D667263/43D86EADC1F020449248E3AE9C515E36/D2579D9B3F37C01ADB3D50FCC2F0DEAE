using System;
using Azure.AI.DocumentIntelligence;
using Azure;
using Azure.Identity;
using Azure.AI.OpenAI;
using DotNetEnv;
using Microsoft.Extensions.AI;

public enum GradingSystem
{
    FivePoint,
    HundredMark
}

public sealed class EnvironmentConfig
{
    public EnvironmentConfig(IChatClient chatClient, DocumentIntelligenceClient docIntelClient, string deploymentName, string languageEndpoint, string languageKey, GradingSystem gradingSystem)
    {
        ChatClient = chatClient;
        DocIntelClient = docIntelClient;
        DeploymentName = deploymentName;
        LanguageEndpoint = languageEndpoint;
        LanguageKey = languageKey;
        GradingSystem = gradingSystem;
    }

    public IChatClient ChatClient { get; }
    public DocumentIntelligenceClient DocIntelClient { get; }
    public string DeploymentName { get; }
    public string LanguageEndpoint { get; }
    public string LanguageKey { get; }
    public GradingSystem GradingSystem { get; }

    public static EnvironmentConfig Build()
    {
        Env.Load();

        var endpoint = Environment.GetEnvironmentVariable("AZURE_OPENAI_ENDPOINT") ??
            throw new InvalidOperationException("AZURE_OPENAI_ENDPOINT is not set.");
        var deploymentName = Environment.GetEnvironmentVariable("AZURE_OPENAI_DEPLOYMENT_NAME") ?? "gpt-4o-mini";
        var chatClient = new AzureOpenAIClient(new Uri(endpoint), new AzureCliCredential())
            .GetChatClient(deploymentName)
            .AsIChatClient();

        var docIntelEndpoint = Environment.GetEnvironmentVariable("DOCINTEL_ENDPOINT") ?? throw new InvalidOperationException("DOCINTEL_ENDPOINT is not set.");
        var docIntelKey = Environment.GetEnvironmentVariable("DOCINTEL_KEY") ?? throw new InvalidOperationException("DOCINTEL_KEY is not set.");
        var docIntelClient = new DocumentIntelligenceClient(new Uri(docIntelEndpoint), new AzureKeyCredential(docIntelKey));

        var languageEndpoint = Environment.GetEnvironmentVariable("AZURE_AI_LANGUAGE_ENDPOINT")
            ?? Environment.GetEnvironmentVariable("ENDPOINT_TO_CALL_LANGUAGE_API")
            ?? throw new InvalidOperationException("AZURE_AI_LANGUAGE_ENDPOINT/ENDPOINT_TO_CALL_LANGUAGE_API is not set.");
        var languageKey = Environment.GetEnvironmentVariable("AZURE_AI_LANGUAGE_KEY")
            ?? Environment.GetEnvironmentVariable("AZURE_AI_KEY")
            ?? throw new InvalidOperationException("AZURE_AI_LANGUAGE_KEY/AZURE_AI_KEY is not set.");

        var gradingSystemValue = Environment.GetEnvironmentVariable("GRADING_SYSTEM") ?? "FivePoint";
        if (!Enum.TryParse(gradingSystemValue, ignoreCase: true, out GradingSystem gradingSystem))
        {
            gradingSystem = GradingSystem.FivePoint;
        }

        return new EnvironmentConfig(chatClient, docIntelClient, deploymentName, languageEndpoint, languageKey, gradingSystem);
    }
}
