using System;
using System.Collections.Generic;
using System.Linq;
using System.Text.Json;
using System.Threading.Tasks;
using Microsoft.Agents.AI;
using Microsoft.Agents.AI.Workflows;
using Microsoft.Extensions.AI;

public sealed class ConvoSumm
{
    public static async Task GenerateAsync(
        EnvironmentConfig config,
        IEnumerable<string> exchangeHistory,
        IEnumerable<int> scores,
        string finalDecisionText,
        string candidateName,
        string outputPath,
        double? englishCommunicationScore)
    {
        var historyText = string.Join("\n---\n", exchangeHistory);
        var scoresText = string.Join(", ", scores);
        if (string.IsNullOrWhiteSpace(historyText))
        {
            Console.WriteLine("No interview history available; skipping report generation.");
            return;
        }

        var systemPrompt = """
You are a report writer generating a concise interview report as JSON.
Structure the JSON exactly as follows:
{
  "quickRecap": string,
  "technicalTraining": [ { "title": string, "summary": string, "rating": number } ],
  "softSkills": [ { "title": string, "summary": string, "rating": number } ],
  "discussionSummary": string,
  "discussionTopics": [ { "title": string, "summary": string } ],
  "interviewerComments": string
}
Guidelines:
- Base everything only on the provided interview conversation history and evaluator scores.
- Derive ratings from evaluator scores: when multiple questions touch the same topic, aggregate/average their scores (1-5). If only one question for a topic, use that score. Use the final score after follow-ups if present. Keep ratings in 1-5 range.
- technicalTraining: include 3-6 key skills/topics discussed, each with a short summary and the aggregated rating.
- softSkills: include only 2 items: Attitude and Interpersonal Skill Communication, with rating 1-5 inferred from dialogue tone/content.
- quickRecap: 3-4 sentences summarizing overall performance and decision readiness.
- discussionSummary: 2-3 sentences recapping the overall discussion.
- discussionTopics: 4-8 titled sections; each title is the topic name and the summary is 2-5 sentences detailing what was discussed, strengths, and gaps.
- interviewerComments: brief recommendation; if decision indicates not to proceed or concerns, state it clearly.
Keep language concise and professional.
""";
        var userPrompt = $"Interview conversation history with evaluator scores (look for 'Score: N'):\n{historyText}\n\nAll recorded scores: {scoresText}\nFinal manager decision text: {finalDecisionText}\nReturn only the JSON schema above.";

        var summarizerAgent = new ChatClientAgent(
            config.ChatClient,
            systemPrompt,
            "report_summarizer",
            "Generates structured interview report JSON");

        var messages = new List<ChatMessage>
        {
            new(ChatRole.User, userPrompt)
        };

        string json;
        try
        {
            var result = await summarizerAgent.RunAsync(messages, thread: null, options: null, cancellationToken: default);
            var last = result.Messages?.LastOrDefault();
            json = last?.GetType().GetProperty("Text")?.GetValue(last) as string
                ?? last?.ToString()
                ?? string.Empty;
            json = json.Trim();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LLM summarization failed: {ex.Message}");
            return;
        }

        ReportPayload payload;
        try
        {
            payload = JsonSerializer.Deserialize<ReportPayload>(json, new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            }) ?? new ReportPayload();
        }
        catch
        {
            payload = new ReportPayload();
        }

        payload.QuickRecap ??= string.Empty;
        payload.DiscussionSummary ??= string.Empty;
        payload.InterviewerComments ??= string.Empty;
        payload.TechnicalTraining ??= new List<SectionItem>();
        payload.SoftSkills ??= new List<SectionItem>();
        payload.DiscussionTopics ??= new List<DiscussionTopic>();

        if (payload.TechnicalTraining.Count == 0)
        {
            payload.TechnicalTraining.Add(new SectionItem { Title = "Overall Technical", Summary = payload.DiscussionSummary, Rating = scores.Any() ? scores.Average() : 0 });
        }

        if (payload.SoftSkills.Count == 0)
        {
            payload.SoftSkills.Add(new SectionItem { Title = "Attitude", Summary = "Not provided", Rating = 0 });
            payload.SoftSkills.Add(new SectionItem { Title = "Interpersonal Skill Communication", Summary = "Not provided", Rating = 0 });
        }

        payload.SoftSkills = NormalizeSoftSkills(payload.SoftSkills, englishCommunicationScore);

        // Print to console
        PrintReport(candidateName, payload);

        if (string.IsNullOrWhiteSpace(outputPath))
        {
            Console.WriteLine("\n PDF generation skipped: output path not provided.");
            return;
        }

        try
        {
            ReportGeneration.GeneratePdfReport(candidateName, payload, scores, outputPath);
            Console.WriteLine($"\n PDF Report generated successfully: {outputPath}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"\n PDF generation failed: {ex.Message}");
        }
    }

    private static List<SectionItem> NormalizeSoftSkills(List<SectionItem> items, double? englishCommunicationScore)
    {
        var normalized = new List<SectionItem>();

        var attitude = items.FirstOrDefault(i => string.Equals(i.Title, "Attitude", StringComparison.OrdinalIgnoreCase));
        var interpersonal = items.FirstOrDefault(i => i.Title != null && i.Title.Contains("Interpersonal", StringComparison.OrdinalIgnoreCase));

        normalized.Add(new SectionItem
        {
            Title = "English Communication",
            Summary = "Pronunciation and fluency assessed from spoken responses.",
            Rating = englishCommunicationScore.HasValue ? MapScoreToFive(englishCommunicationScore.Value) : 0
        });

        normalized.Add(new SectionItem
        {
            Title = "Attitude",
            Summary = attitude?.Summary ?? "Not provided",
            Rating = attitude?.Rating ?? 0
        });

        normalized.Add(new SectionItem
        {
            Title = "Interpersonal Skill Communication",
            Summary = interpersonal?.Summary ?? "Not provided",
            Rating = interpersonal?.Rating ?? 0
        });

        return normalized;
    }

    private static double MapScoreToFive(double pronunciationScore)
    {
        var mapped = pronunciationScore / 20.0;
        return Math.Clamp(mapped, 0, 5);
    }

    private static void PrintReport(string candidateName, ReportPayload payload)
    {
        Console.WriteLine($"\n===== Interview Report - {candidateName} =====");
        Console.WriteLine("\nQuick Recap:\n" + payload.QuickRecap);

        Console.WriteLine("\nTechnical Training:");
        foreach (var item in payload.TechnicalTraining)
        {
            Console.WriteLine($"- {item.Title} (Rating: {item.Rating:F1}/5): {item.Summary}");
        }

        Console.WriteLine("\nSoft Skills:");
        foreach (var item in payload.SoftSkills)
        {
            Console.WriteLine($"- {item.Title} (Rating: {item.Rating:F1}/5): {item.Summary}");
        }

        Console.WriteLine("\nSummary of Discussion:");
        foreach (var topic in payload.DiscussionTopics)
        {
            Console.WriteLine($"\n{topic.Title}:");
            Console.WriteLine(topic.Summary);
        }

        Console.WriteLine("\nInterviewer Comments:\n" + payload.InterviewerComments);
        Console.WriteLine("===== End of Report =====\n");
    }

    public sealed class ReportPayload
    {
        public string? QuickRecap { get; set; }
        public List<SectionItem>? TechnicalTraining { get; set; }
        public List<SectionItem>? SoftSkills { get; set; }
        public string? DiscussionSummary { get; set; }
        public List<DiscussionTopic>? DiscussionTopics { get; set; }
        public string? InterviewerComments { get; set; }
    }

    public sealed class SectionItem
    {
        public string? Title { get; set; }
        public string? Summary { get; set; }
        public double Rating { get; set; }
    }

    public sealed class DiscussionTopic
    {
        public string? Title { get; set; }
        public string? Summary { get; set; }
    }
}